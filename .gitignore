# ── Dependencias ────────────────────────────────────────────────────────
node_modules/

# ── Secretos y Variables de Entorno ─────────────────────────────────────
# ¡NUNCA SUBIR EL .env! Contiene tu GROQ_API_KEY
.env

# ── Sesión de WhatsApp (Privacidad) ─────────────────────────────────────
# Contiene los tokens de acceso de tu número de teléfono
.wwebjs_auth/

# ── Bases de Datos y Configuración Local ────────────────────────────────
# Ignoramos la base de datos de pedidos y la configuración de impresoras
# de esta máquina para que no se sobreescriban al descargar el código en otra.
orders.json
config.json

# ── Archivos Temporales de Impresión ────────────────────────────────────
# Ignoramos todos los tickets generados para el Bloc de notas / PowerShell
ticket_*.txt

# ── Logs y Depuración ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
*.pid.lock

# ── Archivos del Sistema Operativo (Windows / Mac) ──────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Caché de WhatsApp Web JS ─────────────────────────────────────────
.wwebjs_cache/