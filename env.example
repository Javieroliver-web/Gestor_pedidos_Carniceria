# ── Obligatorio ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Impresora ─────────────────────────────────────────────────────────────────
# Opción A — Impresora USB/Windows compartida (recomendado)
#   1. Instalar la impresora en Windows con su driver
#   2. Clic derecho → Propiedades de impresora → pestaña "Compartir"
#   3. Darle un nombre de recurso compartido, p. ej. "Tickets"
#   4. Usar ese nombre aquí:
PRINTER_INTERFACE=printer:Tickets

# Opción B — Impresora en red por TCP (si la impresora tiene WiFi/Ethernet)
#   Cambiar la IP por la de tu impresora (ver en menú de la impresora o router)
# PRINTER_INTERFACE=tcp://192.168.1.100:9100

# ── Nombre del local ──────────────────────────────────────────────────────────
SHOP_NAME=CARNICERÍA DON CARLOS
