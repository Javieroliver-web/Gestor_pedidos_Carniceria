# Copia este archivo a .env y rellena los valores.
#   copy .env.example .env

# Clave gratuita de https://console.groq.com (obligatoria)
GROQ_API_KEY=

# Nombre exacto de la impresora tal y como aparece en Windows
PRINTER_INTERFACE=

# Nombre del negocio que sale impreso en el ticket
SHOP_NAME=

# Puerto del panel web
PORT=3000

# Interfaz de escucha del panel.
#   127.0.0.1 -> solo accesible desde este PC (recomendado)
#   0.0.0.0   -> accesible desde cualquier equipo de la red local. Solo
#                funciona si además pones PANEL_PASSWORD: sin contraseña,
#                el bot se queda en 127.0.0.1 y lo avisa en el log.
HOST=127.0.0.1

# Contraseña del panel, obligatoria para HOST=0.0.0.0. El navegador la pide
# una vez (usuario: panel).
PANEL_PASSWORD=

# Respaldo de IA si Groq falla (opcional, gratis en https://aistudio.google.com)
GEMINI_API_KEY=

# Modelos de IA (opcional, si se dejan vacíos se usan estos). Si Groq o Google
# retiran uno, el bot busca el sucesor solo, lo guarda en config.json y lo
# avisa en el log (npm run bot:logs). Lo que pongas aquí manda.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
