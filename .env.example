# Copia este archivo a .env y rellena los valores.
#   copy .env.example .env

# Clave gratuita de https://console.groq.com (obligatoria)
GROQ_API_KEY=

# Nombre exacto de la impresora tal y como aparece en Windows
PRINTER_INTERFACE=

# Nombre del negocio que sale impreso en el ticket
SHOP_NAME=

# Puerto del panel web
PORT=3000

# Interfaz de escucha del panel.
#   127.0.0.1 -> solo accesible desde este PC (recomendado)
#   0.0.0.0   -> accesible desde cualquier equipo de la red local.
#                El panel NO pide contraseña, así que cualquiera en esa red
#                podría ver los pedidos o desvincular WhatsApp.
HOST=127.0.0.1
